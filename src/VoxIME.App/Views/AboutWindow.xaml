<Window x:Class="VoxIME.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:VoxIME.App.Infrastructure"
        Title="关于 VoxIME 声语"
        Width="540"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <Grid>
        <inf:WindowShadowLayer IsHitTestVisible="False" Inset="18" />
        <Border x:Name="RootBorder" Margin="18" Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                CornerRadius="16">
        <Grid>
            <!-- 自定义背景暗化遮罩：保证文字对比度（主题色模式下为全透明） -->
            <Border CornerRadius="16" Background="{DynamicResource WindowDimBrush}" IsHitTestVisible="False" />

            <StackPanel>
            <!-- 标题栏 -->
            <Border x:Name="TitleBar" Padding="20,14,12,0" Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="关于" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;"
                            Click="CloseButton_Click" ToolTip="关闭" />
                </Grid>
            </Border>

            <!-- Logo / 版本 -->
            <StackPanel Orientation="Horizontal" Margin="24,18,24,0">
                <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource AccentGradient}"
                        Effect="{DynamicResource AccentGlow}">
                    <TextBlock Text="V" FontSize="32" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="16,2,0,0" VerticalAlignment="Center">
                    <TextBlock Text="VoxIME 声语" FontSize="20" FontWeight="Bold" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    <TextBlock Text="Windows 语音输入法 · 悬浮语音助手" Style="{StaticResource MutedText}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Margin="24,16,24,0" Style="{StaticResource HintText}"
                       Text="按住热键说一句话，识别结果会自动插入当前光标处；支持多厂商云端 ASR、本地 CLI 识别、SAPI 朗读与 Live2D 桌宠状态联动。" />

            <Border Style="{StaticResource Card}" Margin="24,16,24,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="技术组件与许可" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource HintText}" LineHeight="19">
                        <Run Text="NAudio（MIT License） · Microsoft.Web.WebView2（Microsoft 许可）" /><LineBreak />
                        <Run Text="System.Speech / Windows DPAPI（.NET 平台组件）" /><LineBreak />
                        <Run Text="Live2D Cubism Core、pixi.js、pixi-live2d-display（各自版权与许可）" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                               Text="Live2D 示例模型版权归 Live2D Inc. 所有，仅用于开发与测试，正式分发请遵守官方条款。" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                               Text="ASR 服务由各厂商提供，使用产生的费用与合规责任由使用者自行承担。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InnerCard}" Margin="24,12,24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="数据与隐私" Style="{StaticResource CardTitle}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                   Text="配置与历史仅保存在本机 %APPDATA%\VoxIME，API Key 使用 Windows DPAPI 加密。" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 按钮 -->
            <Grid Margin="24,18,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource LinkButton}" Content="打开配置目录"
                            Click="OpenConfigButton_Click" />
                    <Button Style="{StaticResource LinkButton}" Content="打开日志目录" Margin="12,0,0,0"
                            Click="OpenLogsButton_Click" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="关闭"
                        MinWidth="96" Click="CloseButton_Click" />
            </Grid>
        </StackPanel>
        </Grid>
        </Border>
    </Grid>
</Window>
