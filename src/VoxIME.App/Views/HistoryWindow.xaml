<Window x:Class="VoxIME.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoxIME 历史记录"
        Width="860"
        Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="{x:Null}">

    <Border Margin="18" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
            CornerRadius="16" Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="Transparent" Padding="18,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" CornerRadius="8"
                            Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource GlyphIcon}" FontSize="12" Text="&#xE81C;"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="历史记录" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;"
                            Click="CloseButton_Click" ToolTip="关闭" />
                </Grid>
            </Border>

            <!-- 工具条 -->
            <Grid Grid.Row="1" Margin="18,4,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" MaxWidth="360" HorizontalAlignment="Left">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按文本或服务名搜索" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource GlyphIcon}" FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right"
                               Margin="0,0,10,0" IsHitTestVisible="False" />
                </Grid>
                <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="刷新"
                        Command="{Binding RefreshCommand}" Margin="10,0,0,0" />
                <Button Grid.Column="2" Style="{StaticResource DangerGhostButton}" Content="清空"
                        Click="ClearButton_Click" Margin="8,0,0,0" />
            </Grid>

            <!-- 列表表头 -->
            <Border Grid.Row="2" Background="{DynamicResource CardBrush}" CornerRadius="10,10,0,0"
                    Padding="14,9" Margin="18,0,18,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="时间" Style="{StaticResource FieldLabel}" Margin="0" />
                    <TextBlock Grid.Column="1" Text="识别文本" Style="{StaticResource FieldLabel}" Margin="0" />
                    <TextBlock Grid.Column="2" Text="服务" Style="{StaticResource FieldLabel}" Margin="0" />
                    <TextBlock Grid.Column="3" Text="时长" Style="{StaticResource FieldLabel}" Margin="0" />
                    <TextBlock Grid.Column="4" Text="延迟" Style="{StaticResource FieldLabel}" Margin="0" />
                    <TextBlock Grid.Column="5" Text="上屏" Style="{StaticResource FieldLabel}" Margin="0" />
                </Grid>
            </Border>

            <!-- 记录列表 -->
            <Grid Grid.Row="3" Margin="18,0,18,8">
                <ListBox ItemsSource="{Binding Records}"
                         ItemContainerStyle="{StaticResource HistoryRowStyle}"
                         MouseDoubleClick="RecordsList_MouseDoubleClick"
                         HorizontalContentAlignment="Stretch"
                         Background="{DynamicResource CardBrush}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ToolTip="双击复制识别文本">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Error}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LocalTimeLabel}"
                                           Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="2" Text="{Binding ProviderName}"
                                           Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="3" Text="{Binding DurationLabel}"
                                           Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding Latency.TotalSeconds, StringFormat={}{0:0.00}s}"
                                           Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="&#xE73E;" VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFont}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Inserted}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空状态 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE81C;" FontSize="30"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="还没有历史记录" Foreground="{DynamicResource SubtleTextBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="用热键说一句话，识别结果会自动出现在这里"
                               Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 底部 -->
            <Border Grid.Row="4" Padding="18,10" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock Text="双击任意一行可复制识别文本" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Records.Count, StringFormat='共 {0} 条'}" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

