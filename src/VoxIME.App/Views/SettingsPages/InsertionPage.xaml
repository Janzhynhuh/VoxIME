<UserControl x:Class="VoxIME.App.Views.SettingsPages.InsertionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:VoxIME.App.Infrastructure">

    <ScrollViewer inf:SmoothScroll.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel Margin="0,0,0,20">

            <!-- 插入方式 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="插入方式" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="剪贴板粘贴兼容性最好；模拟输入不会污染剪贴板，但速度较慢，部分应用可能不兼容。" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="剪贴板粘贴（推荐）" GroupName="InsertionMode"
                                     IsChecked="{Binding IsClipboardPasteMode, Mode=TwoWay}" />
                        <RadioButton Content="模拟键盘输入" GroupName="InsertionMode" Margin="12,0,0,0"
                                     IsChecked="{Binding IsSimulateTypingMode, Mode=TwoWay}" />
                    </StackPanel>

                    <CheckBox Content="识别完成后自动插入到当前焦点应用" Margin="0,14,0,0"
                              IsChecked="{Binding AutoInsert, Mode=TwoWay}" />
                    <CheckBox Content="先显示预览，确认（可编辑）后再插入" Margin="0,10,0,0"
                              IsChecked="{Binding PreviewBeforeInsert, Mode=TwoWay}" />
                    <CheckBox Content="插入后还原原剪贴板内容" Margin="0,10,0,0"
                              IsChecked="{Binding RestoreClipboard, Mode=TwoWay}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="插入前等待（让焦点切换）" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="2000" TickFrequency="10"
                                IsSnapToTickEnabled="True" Value="{Binding PasteDelayMs, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding PasteDelayMs, StringFormat={}{0} ms}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 文本处理 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="文本处理" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="去掉识别文本首尾空白" Margin="0,12,0,0"
                              IsChecked="{Binding TrimWhitespace, Mode=TwoWay}" />
                    <CheckBox Content="在文本后追加一个空格" Margin="0,10,0,0"
                              IsChecked="{Binding AppendSpace, Mode=TwoWay}" />
                    <CheckBox Content="插入后按一次回车（适合聊天软件发送）" Margin="0,10,0,0"
                              IsChecked="{Binding PressEnterAfterInsert, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- 术语替换 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="术语替换" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                       Text="识别完成后按顺序做精确文本替换，例如把“微厘米”纠正为“VoxIME”。" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="＋ 添加替换"
                                Command="{Binding AddReplacementCommand}" VerticalAlignment="Top" />
                    </Grid>

                    <Grid Margin="0,12,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="原文" Style="{StaticResource FieldLabel}" Margin="0" />
                        <TextBlock Grid.Column="2" Text="替换为" Style="{StaticResource FieldLabel}" Margin="0" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Replacements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="1" Text="→" Style="{StaticResource MutedText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2"
                                             Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="3" Style="{StaticResource DangerGhostButton}"
                                            Content="&#xE74D;" Padding="0"
                                            Command="{Binding DataContext.RemoveReplacementCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="删除该替换规则" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="还没有替换规则，点击右上角“添加替换”创建一条。"
                               Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Replacements.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 悬浮提示窗 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="悬浮提示窗（HUD）" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="屏幕底部居中的胶囊提示窗，显示状态、实时麦克风电平与识别预览；可拖动调整位置。" />

                    <CheckBox Content="显示悬浮提示窗" IsChecked="{Binding ShowHud, Mode=TwoWay}" />
                    <CheckBox Content="显示实时识别预览文本" Margin="0,10,0,0"
                              IsChecked="{Binding ShowLiveTranscript, Mode=TwoWay}" />
                    <CheckBox Content="预览模式下允许直接插入" Margin="0,10,0,0"
                              IsChecked="{Binding OverlayAutoInsert, Mode=TwoWay}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="空闲后自动隐藏" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="500" Maximum="30000" TickFrequency="250"
                                IsSnapToTickEnabled="True" Value="{Binding OverlayAutoHideMs, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding OverlayAutoHideMs, StringFormat={}{0} ms}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Button Style="{StaticResource GhostButton}" Content="重置悬浮窗位置"
                            HorizontalAlignment="Left" Padding="12,6" Margin="0,12,0,0"
                            Command="{Binding ResetOverlayPositionCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
