<UserControl x:Class="VoxIME.App.Views.SettingsPages.ProvidersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:VoxIME.App.Infrastructure">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="262" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左：服务列表 ===== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="新增识别服务" Style="{StaticResource SectionTitle}" FontSize="13" />
                    <TextBlock Text="{Binding DescriptorCatalogHint}" Style="{StaticResource HintText}"
                               Margin="0,4,0,8" />
                    <ComboBox ItemsSource="{Binding Descriptors}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding NewDescriptor, Mode=TwoWay}"
                              IsEnabled="{Binding HasDescriptorCatalog}" />
                    <ComboBox ItemsSource="{Binding NewPresets}" DisplayMemberPath="Name"
                              SelectedItem="{Binding NewPreset, Mode=TwoWay}" Margin="0,8,0,0"
                              IsEnabled="{Binding HasDescriptorCatalog}">
                        <ComboBox.ToolTip>
                            <ToolTip>选择厂商预设，会自动填入 BaseUrl / 模型 / 语言等参数。</ToolTip>
                        </ComboBox.ToolTip>
                    </ComboBox>
                    <Button Style="{StaticResource PrimaryButton}" Content="＋ 添加服务" Margin="0,10,0,0"
                            Command="{Binding AddProviderCommand}" />
                </StackPanel>
            </Border>

            <ListBox Grid.Row="1" ItemsSource="{Binding Providers}"
                     SelectedItem="{Binding SelectedProvider, Mode=TwoWay}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="Margin" Value="0,0,0,3" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="9" Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5"
                                            Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="默认" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0">
                                    <Run Text="{Binding CategoryLabel, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding StatusLabel, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      ToolTip="启用 / 停用该服务" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource SmallButton}" Content="设为默认"
                        Command="{Binding SetDefaultProviderCommand}" />
                <Button Style="{StaticResource DangerGhostButton}" Content="删除" Margin="8,0,0,0"
                        Command="{Binding RemoveProviderCommand}" />
            </StackPanel>
        </Grid>

        <!-- ===== 右：编辑表单 ===== -->
        <ScrollViewer inf:SmoothScroll.IsEnabled="True" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel Margin="0,0,0,20">
                <!-- 未选择 -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasSelectedProvider, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <StackPanel>
                        <TextBlock Text="请选择一个服务" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   Text="在左侧列表中选择要编辑的服务，或使用上方“新增识别服务”添加一个适配器。" />
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding HasSelectedProvider, Converter={StaticResource BoolToVis}}">
                    <!-- 基本信息 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="基本信息" Style="{StaticResource SectionTitle}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedProvider.Id}"
                                           Style="{StaticResource MonoText}" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="服务名称" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding SelectedProvider.Name, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="适配器类型" Style="{StaticResource FieldLabel}" />
                                    <Border Style="{StaticResource InnerCard}" Padding="10,7">
                                        <TextBlock Text="{Binding SelectedProvider.TypeDisplayName}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="启用该服务" IsChecked="{Binding SelectedProvider.Enabled, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedProvider.StatusLabel}"
                                           Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 连接参数 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="连接 / 识别参数" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                                       Text="BaseUrl 通常以 /v1 结尾（适配器会自动容错）；模型名以厂商文档为准。" />

                            <StackPanel Visibility="{Binding SelectedProvider.UsesBaseUrl, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="BaseUrl" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SelectedProvider.BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="例如 https://api.openai.com/v1" />
                            </StackPanel>

                            <Grid Margin="0,12,0,0"
                                  Visibility="{Binding SelectedProvider.UsesModel, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="模型" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding SelectedProvider.Model, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="例如 whisper-1 / FunAudioLLM/SenseVoiceSmall" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="语言" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding SelectedProvider.Language, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="zh / en / auto（留空默认 zh）" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,12,0,0" Visibility="{Binding SelectedProvider.UsesPrompt, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="识别提示词（可选）" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource MultilineTextBox}" MinHeight="52"
                                         Text="{Binding SelectedProvider.Prompt, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="用于 Whisper prompt 或识别上下文，例如专有名词列表。" />
                            </StackPanel>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="超时" Style="{StaticResource FieldLabel}" Margin="0,0,12,0"
                                           VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="5" Maximum="600"
                                        Value="{Binding SelectedProvider.TimeoutSeconds, Mode=TwoWay}"
                                        IsSnapToTickEnabled="True" TickFrequency="5" />
                                <TextBlock Grid.Column="2" Text="{Binding SelectedProvider.TimeoutLabel}"
                                           Style="{StaticResource MutedText}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" MinWidth="52" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 凭据 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                            Visibility="{Binding SelectedProvider.UsesAnyCredential, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="凭据" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                                       Text="凭据仅保存在本机，落盘时使用 Windows DPAPI 加密（当前用户）。" />

                            <StackPanel Visibility="{Binding SelectedProvider.UsesApiKey, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SelectedProvider.ApiKeyLabel}" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged" />
                            </StackPanel>

                            <StackPanel Margin="0,12,0,0" Visibility="{Binding SelectedProvider.UsesSecretId, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="SecretId" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="SecretIdBox" PasswordChanged="SecretIdBox_PasswordChanged" />
                            </StackPanel>

                            <StackPanel Margin="0,12,0,0" Visibility="{Binding SelectedProvider.UsesApiSecret, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="ApiSecret / SecretKey" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="ApiSecretBox" PasswordChanged="ApiSecretBox_PasswordChanged" />
                            </StackPanel>

                            <StackPanel Margin="0,12,0,0" Visibility="{Binding SelectedProvider.UsesAppId, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="AppId（非敏感）" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SelectedProvider.AppId, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 本地 CLI -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                            Visibility="{Binding SelectedProvider.IsLocalCli, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="本地命令行" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                                       Text="参数模板支持 {wav} {out} {lang} 占位符；OutputMode 决定从哪里读取识别文本。" />

                            <TextBlock Text="可执行文件（或命令名）" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SelectedProvider.Command, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="例如 whisper-cli 或 C:\tools\whisper\whisper-cli.exe" />

                            <TextBlock Text="参数模板" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                            <TextBox Text="{Binding SelectedProvider.CommandArguments, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="-m &quot;{model}&quot; -f &quot;{wav}&quot; -l {lang} -otxt -of &quot;{out}&quot;" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="输出模式" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding SelectedProvider.OutputModes}"
                                              SelectedItem="{Binding SelectedProvider.OutputMode, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="输出文件模板（file 模式）" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding SelectedProvider.OutputFileTemplate, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{}{out}.txt" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 高级 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="高级" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="附加请求参数（JSON，会合并进请求体，可留空）"
                                       Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                            <TextBox Style="{StaticResource MultilineTextBox}" MinHeight="60"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     Text="{Binding SelectedProvider.ExtraJson, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{}{&quot;temperature&quot;: 0.0}" />
                        </StackPanel>
                    </Border>

                    <!-- 测试 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="测试识别" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                                       Text="点击后会录制 3 秒麦克风音频并调用当前服务识别，不会插入文本。" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="测试识别"
                                        Padding="16,8" Command="{Binding TestProviderCommand}" />
                                <Button Style="{StaticResource LinkButton}" Content="厂商文档"
                                        Margin="10,0,0,0"
                                        Command="{Binding OpenProviderDocsCommand}" />
                                <TextBlock Text="测试中…" Style="{StaticResource MutedText}"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsTesting, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <Border Style="{StaticResource InnerCard}" Margin="0,10,0,0"
                                    Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding TestResultText}" TextWrapping="Wrap" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTestSuccess}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>


