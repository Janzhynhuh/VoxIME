<UserControl x:Class="VoxIME.App.Views.SettingsPages.Live2DPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:VoxIME.App.Infrastructure">

    <UserControl.Resources>
        <!-- 静默循环：只勾选（一律循环） -->
        <DataTemplate x:Key="MotionGroupSimpleRow">
            <CheckBox Content="{Binding Group}" Margin="0,1"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
        </DataTemplate>

        <!-- 待机随机池：勾选 + 权重 + 是否保持末帧 -->
        <DataTemplate x:Key="MotionPoolRow">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Content="{Binding Group}" VerticalAlignment="Center"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Margin="6,0,0,0" Height="24" VerticalContentAlignment="Center"
                         Text="{Binding Weight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="随机权重 1-10，越大越容易被抽中" />
                <CheckBox Grid.Column="2" Content="保持末帧" VerticalAlignment="Center" Margin="8,0,0,0"
                          IsChecked="{Binding Hold, Mode=TwoWay}"
                          ToolTip="勾选：播完停在最后姿势；不勾：播完回到静默循环姿势" />
            </Grid>
        </DataTemplate>

        <!-- 触发动作：勾选 + 事件（点击/加载） + 是否保持末帧 -->
        <DataTemplate x:Key="MotionTriggerRow">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Content="{Binding Group}" VerticalAlignment="Center"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                <ComboBox Grid.Column="1" Margin="6,0,0,0" Height="26"
                          ItemsSource="{Binding EventChoices}"
                          SelectedItem="{Binding TriggerEvent, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          ToolTip="点击桌宠（需关闭点击穿透，或从托盘「互动一下」触发）/ 模型加载时" />
                <CheckBox Grid.Column="2" Content="保持末帧" VerticalAlignment="Center" Margin="8,0,0,0"
                          IsChecked="{Binding Hold, Mode=TwoWay}"
                          ToolTip="勾选：播完停在最后姿势；不勾：播完回到待机" />
            </Grid>
        </DataTemplate>

        <!-- 状态动作：勾选 + 模式（循环 / 进入时播一次） -->
        <DataTemplate x:Key="MotionGroupOptionRow">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Content="{Binding Group}" VerticalAlignment="Center"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                <ComboBox Grid.Column="1" Margin="6,0,0,0" Height="26"
                          ItemsSource="{Binding ModeChoices}"
                          SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          ToolTip="循环：状态期间持续播放；进入时播一次：只播一遍，保持到状态结束" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer inf:SmoothScroll.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel Margin="0,0,0,20">

            <!-- 开关与模型 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="桌宠模型" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="从下拉框选择内置兜底形象或已导入的 Live2D 模型；也可以导入新的模型（文件夹或 zip）。" />

                    <CheckBox Content="启用 Live2D 桌宠" IsChecked="{Binding Live2DEnabled, Mode=TwoWay}" />

                    <TextBlock Text="选择模型" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding AvailableLive2DModels}"
                                  SelectedItem="{Binding SelectedLive2DModel, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  ToolTip="内置兜底形象或模型库中的模型；选择后点击“保存”生效" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="导入文件夹…"
                                Margin="8,0,0,0" Padding="14,7"
                                Command="{Binding ImportLive2DModelCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="导入 ZIP…"
                                Margin="8,0,0,0" Padding="14,7"
                                Command="{Binding ImportLive2DModelZipCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                               Text="导入会把模型复制到下面的模型库位置（默认 %APPDATA%\VoxIME\models，原文件夹保留），重名自动加序号；支持完整 Cubism 3/4 模型目录或 zip。" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource SmallButton}" Content="打开模型库目录"
                                Command="{Binding OpenLive2DModelsFolderCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="刷新列表" Margin="8,0,0,0"
                                Command="{Binding RefreshLive2DModelsCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="删除选中模型" Margin="8,0,0,0"
                                Command="{Binding DeleteLive2DModelCommand}" />
                    </StackPanel>

                    <TextBlock Text="模型库位置" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding ModelLibraryDirectory, Mode=OneWay}"
                                 IsReadOnly="True"
                                 ToolTip="当前模型库位置；点右侧“修改位置…”可更换" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="修改位置…"
                                Margin="8,0,0,0" Padding="14,7"
                                Command="{Binding BrowseModelLibraryDirectoryCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                               Text="默认 %APPDATA%\VoxIME\models；修改后新导入的模型会复制到新位置，已有模型不会自动迁移。" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Live2DStatusText}"
                                   Style="{StaticResource HintText}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource SmallButton}" Content="显示桌宠"
                                    Command="{Binding ShowLive2DCommand}" />
                            <Button Style="{StaticResource SmallButton}" Content="隐藏桌宠" Margin="8,0,0,0"
                                    Command="{Binding HideLive2DCommand}" />
                            <Button Style="{StaticResource SmallButton}" Content="重置位置" Margin="8,0,0,0"
                                    Command="{Binding ResetLive2DPositionCommand}"
                                    ToolTip="清除保存的位置，把桌宠移回当前屏幕右下角（关闭贴边时居中）" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 外观 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="外观与交互" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,12,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="窗口宽度" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="160" Maximum="1600" TickFrequency="20"
                                IsSnapToTickEnabled="True" Value="{Binding Live2DWidth, Mode=TwoWay}"
                                IsEnabled="{Binding IsManualWindowWidthEnabled}" />
                        <TextBlock Grid.Column="2" Text="{Binding Live2DWidth, StringFormat={}{0:0} px}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="窗口高度" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="160" Maximum="1600" TickFrequency="20"
                                IsSnapToTickEnabled="True" Value="{Binding Live2DHeight, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding Live2DHeight, StringFormat={}{0:0} px}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <CheckBox Content="窗口宽度随模型自动收紧（高度不变，左右各留约 5px padding）"
                              Margin="0,0,0,2" IsChecked="{Binding AutoFitWindow, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="24,-2,0,10"
                               Text="开启后宽度由模型自动计算，宽度滑块会置灰不可手动调整；关闭后可手动调宽。" />

                    <CheckBox Content="窗口下边自动吸附（拖到当前屏幕底部时贴底；首次显示在右下角）"
                              Margin="0,0,0,4" IsChecked="{Binding SnapToEdge, Mode=TwoWay}" />
                    <CheckBox Content="贴边时整个窗口底部保持在任务栏之上"
                              Margin="24,0,0,10" IsChecked="{Binding KeepAboveTaskbar, Mode=TwoWay}"
                              IsEnabled="{Binding SnapToEdge}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,-4,0,10"
                               Text="只吸附窗口下边：拖到当前屏幕底部约 100px 内会贴底，向上拖不会被拉回；左右上方向不吸附。贴底只改变上下位置，不会移动左右。关闭后使用上次拖动保存的位置，首次没有位置时屏幕居中。" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="模型缩放" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="0.2" Maximum="3" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" Value="{Binding Live2DScale, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding Live2DScale, StringFormat={}{0:0.0}×}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Margin="150,2,0,8"
                               Text="缩放 &gt;1 会放大模型并裁剪超出窗口部分；想要更大更清晰的显示区域，请调大上面的「窗口宽度 / 高度」。画面按窗口像素尺寸与缩放实时提高渲染分辨率。" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="模型水平偏移" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="-1" Maximum="1" TickFrequency="0.01"
                                IsSnapToTickEnabled="True" Value="{Binding ModelOffsetX, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding ModelOffsetX, StringFormat={}{0:P0}}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="模型垂直偏移" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="-1" Maximum="1" TickFrequency="0.01"
                                IsSnapToTickEnabled="True" Value="{Binding ModelOffsetY, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding ModelOffsetY, StringFormat={}{0:P0}}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Margin="150,2,0,8"
                               Text="偏移按窗口宽/高的百分比计算（正值 = 右 / 下）；放大后可把模型移到想显示的位置，0%,0% 为默认居中贴底。" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="窗口透明度" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="0.2" Maximum="1" TickFrequency="0.01"
                                IsSnapToTickEnabled="True" Value="{Binding Live2DOpacity, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding Live2DOpacity, StringFormat={}{0:P0}}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <CheckBox Content="鼠标点击穿透（不挡住下层窗口）" IsChecked="{Binding ClickThrough, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                               Text="也可以在系统托盘图标右键菜单里直接开启/关闭“桌宠点击穿透”，不用每次打开设置。" />
                    <CheckBox Content="窗口始终置顶" Margin="0,10,0,0"
                              IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" />
                    <CheckBox Content="显示对话气泡" Margin="0,10,0,0"
                              IsChecked="{Binding ShowBubble, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- 动作与口型 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="动作与口型" Style="{StaticResource SectionTitle}" />

                    <CheckBox Content="眼动跟随鼠标" Margin="0,12,0,0"
                              IsChecked="{Binding EyeFollow, Mode=TwoWay}" />

                    <Grid Margin="0,8,0,0" IsEnabled="{Binding EyeFollow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="眼动采样帧率" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="5" Maximum="300" TickFrequency="5"
                                IsSnapToTickEnabled="True" Value="{Binding EyeFollowFps, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding EyeFollowFps, StringFormat={}{0} FPS}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Margin="150,4,0,0"
                               Text="默认 30 FPS（5–300 可调）。采样在后台线程进行，实际画面更新上限是显示器刷新率（常见 60/144/165Hz）；调高主要让快速移动时更跟手，过高只会增加少量 CPU。" />

                    <CheckBox Content="眼动上下反转（按当前模型记忆；部分模型骨骼绑定方向相反）"
                              Margin="0,10,0,0" IsEnabled="{Binding EyeFollow}"
                              IsChecked="{Binding EyeFollowInvertY, Mode=TwoWay}" />

                    <CheckBox Content="待机动画循环" Margin="0,10,0,0"
                              IsChecked="{Binding IdleMotion, Mode=TwoWay}" />
                    <CheckBox Content="朗读 / 说话时口型同步" Margin="0,10,0,0"
                              IsChecked="{Binding MouthSync, Mode=TwoWay}" />
                    <CheckBox Content="TTS 播放时驱动桌宠口型" Margin="0,10,0,0"
                              IsChecked="{Binding TtsMouthSync, Mode=TwoWay}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="口型灵敏度" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="0.1" Maximum="5" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" Value="{Binding MouthSensitivity, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding MouthSensitivity, StringFormat={}{0:0.0}}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="静默循环（持续播放，可多选叠加）" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="预览"
                                Command="{Binding PreviewIdleMotionCommand}" />
                    </Grid>
                    <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsEnabled="{Binding IdleMotion}">
                        <ItemsControl ItemsSource="{Binding IdleMotionMapping.Options}"
                                      ItemTemplate="{StaticResource MotionGroupSimpleRow}" />
                    </ScrollViewer>
                    <TextBlock Text="{Binding IdleMotionMapping.Summary}" Style="{StaticResource HintText}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="像 IDLE 这种一直在播的基础动作放这里；一个都不勾 = 自动使用名字含 idle 的动作组。" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="待机随机池（隔一段时间随机播一个小动作）" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="预览"
                                Command="{Binding PreviewIdlePoolCommand}" />
                    </Grid>
                    <Grid Margin="0,6,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="每隔" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Margin="6,0" Height="26" VerticalContentAlignment="Center"
                                 Text="{Binding IdlePoolMinSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="最小间隔（秒，2-600）" />
                        <TextBlock Grid.Column="2" Text="~" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="3" Margin="6,0" Height="26" VerticalContentAlignment="Center"
                                 Text="{Binding IdlePoolMaxSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="最大间隔（秒，2-3600）" />
                        <TextBlock Grid.Column="4" Text="秒随机播放一个（播完默认回静默）"
                                   Style="{StaticResource HintText}" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsEnabled="{Binding IdleMotion}">
                        <ItemsControl ItemsSource="{Binding IdlePoolMapping.Options}"
                                      ItemTemplate="{StaticResource MotionPoolRow}" />
                    </ScrollViewer>
                    <TextBlock Text="{Binding IdlePoolMapping.Summary}" Style="{StaticResource HintText}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="适合转头、伸懒腰这类小动作；权重越大越容易被抽中。默认播完回到静默姿势，需要定住动作的勾「保持末帧」。" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="触发动作（点击桌宠 / 模型加载时）" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="试播"
                                Command="{Binding PreviewTriggerCommand}" />
                    </Grid>
                    <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding TriggerMapping.Options}"
                                      ItemTemplate="{StaticResource MotionTriggerRow}" />
                    </ScrollViewer>
                    <TextBlock Text="{Binding TriggerMapping.Summary}" Style="{StaticResource HintText}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="点击桌宠需要在设置里关闭「点击穿透」，否则点击会穿到下层窗口；也可以从托盘菜单「互动一下」触发。未配置时点击会尝试播放模型里名字含 tap 的动作组。" />

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="兜底形象主题" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FallbackAvatarTheme, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="violet / cyan / ember / slate（取决于 Live2D 实现）" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 动作映射 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="状态动作映射（可选）" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="状态 = 一个特殊的触发源：切到该状态时，每个勾选的动作组各占一条并行动作层。模式选「循环」= 状态期间持续播放；选「进入时播一次」= 只播一遍并保持到状态结束（适合举手/竖手指这类切换动作）。一个都不勾 = 自动使用与状态同名的动作组；勾「不播放」= 该状态不触发动作。最多同时叠加 4 个动作组。预览只播一遍，结束后停 3 秒再恢复待机。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="聆听" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="预览"
                                        Command="{Binding PreviewStateMotionCommand}" CommandParameter="listening" />
                            </Grid>
                            <CheckBox Content="不播放（切到此状态不触发动作）" Margin="0,2,0,6"
                                      IsChecked="{Binding ListeningMotion.Disabled, Mode=TwoWay}" />
                            <ScrollViewer MaxHeight="104" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsEnabled="{Binding ListeningMotion.SelectionEnabled}">
                                <ItemsControl ItemsSource="{Binding ListeningMotion.Options}"
                                              ItemTemplate="{StaticResource MotionGroupOptionRow}" />
                            </ScrollViewer>
                            <TextBlock Text="{Binding ListeningMotion.Summary}" Style="{StaticResource HintText}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="识别中" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="预览"
                                        Command="{Binding PreviewStateMotionCommand}" CommandParameter="thinking" />
                            </Grid>
                            <CheckBox Content="不播放（切到此状态不触发动作）" Margin="0,2,0,6"
                                      IsChecked="{Binding ThinkingMotion.Disabled, Mode=TwoWay}" />
                            <ScrollViewer MaxHeight="104" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsEnabled="{Binding ThinkingMotion.SelectionEnabled}">
                                <ItemsControl ItemsSource="{Binding ThinkingMotion.Options}"
                                              ItemTemplate="{StaticResource MotionGroupOptionRow}" />
                            </ScrollViewer>
                            <TextBlock Text="{Binding ThinkingMotion.Summary}" Style="{StaticResource HintText}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="朗读" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="预览"
                                        Command="{Binding PreviewStateMotionCommand}" CommandParameter="speaking" />
                            </Grid>
                            <CheckBox Content="不播放（切到此状态不触发动作）" Margin="0,2,0,6"
                                      IsChecked="{Binding SpeakingMotion.Disabled, Mode=TwoWay}" />
                            <ScrollViewer MaxHeight="104" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsEnabled="{Binding SpeakingMotion.SelectionEnabled}">
                                <ItemsControl ItemsSource="{Binding SpeakingMotion.Options}"
                                              ItemTemplate="{StaticResource MotionGroupOptionRow}" />
                            </ScrollViewer>
                            <TextBlock Text="{Binding SpeakingMotion.Summary}" Style="{StaticResource HintText}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="出错" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="预览"
                                        Command="{Binding PreviewStateMotionCommand}" CommandParameter="error" />
                            </Grid>
                            <CheckBox Content="不播放（切到此状态不触发动作）" Margin="0,2,0,6"
                                      IsChecked="{Binding ErrorMotion.Disabled, Mode=TwoWay}" />
                            <ScrollViewer MaxHeight="104" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsEnabled="{Binding ErrorMotion.SelectionEnabled}">
                                <ItemsControl ItemsSource="{Binding ErrorMotion.Options}"
                                              ItemTemplate="{StaticResource MotionGroupOptionRow}" />
                            </ScrollViewer>
                            <TextBlock Text="{Binding ErrorMotion.Summary}" Style="{StaticResource HintText}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding MotionPreviewStatus}" Style="{StaticResource HintText}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 表情映射 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="状态表情映射（可选）" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="从当前模型的表情列表中选择（自动扫描 model3.json 和 Exp3 文件夹）；也可以手动输入，留空表示不切换表情。" />
                    <TextBlock Text="{Binding ExpressionCatalogHint}" Style="{StaticResource HintText}"
                               Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="聆听" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" IsEditable="True" ItemsSource="{Binding AvailableExpressions}"
                                          Text="{Binding ListeningExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="预览"
                                        Margin="8,0,0,0" Command="{Binding PreviewExpressionCommand}"
                                        CommandParameter="listening" />
                            </Grid>
                            <TextBlock Text="识别中" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" IsEditable="True" ItemsSource="{Binding AvailableExpressions}"
                                          Text="{Binding ThinkingExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="预览"
                                        Margin="8,0,0,0" Command="{Binding PreviewExpressionCommand}"
                                        CommandParameter="thinking" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="朗读" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" IsEditable="True" ItemsSource="{Binding AvailableExpressions}"
                                          Text="{Binding SpeakingExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="预览"
                                        Margin="8,0,0,0" Command="{Binding PreviewExpressionCommand}"
                                        CommandParameter="speaking" />
                            </Grid>
                            <TextBlock Text="出错" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" IsEditable="True" ItemsSource="{Binding AvailableExpressions}"
                                          Text="{Binding ErrorExpression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="预览"
                                        Margin="8,0,0,0" Command="{Binding PreviewExpressionCommand}"
                                        CommandParameter="error" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ExpressionPreviewStatus}" Style="{StaticResource HintText}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
