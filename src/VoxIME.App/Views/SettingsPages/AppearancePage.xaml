<UserControl x:Class="VoxIME.App.Views.SettingsPages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:VoxIME.App.Infrastructure">

    <UserControl.Resources>
        <!-- 配色卡片：按钮即卡片，DataContext 为 ColorSchemeOption。 -->
        <Style x:Key="SchemeCardButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="204" CornerRadius="12" Padding="12,10"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <StackPanel>
                                <!-- 迷你窗口色卡：背景 / 卡片 / 强调色 / 正文色条 -->
                                <Border Height="62" CornerRadius="8" Padding="10"
                                        Background="{Binding PreviewBackgroundBrush}"
                                        BorderBrush="{Binding PreviewBorderBrush}" BorderThickness="1">
                                    <Border CornerRadius="6" Padding="8,0" VerticalAlignment="Center"
                                            Background="{Binding PreviewSurfaceBrush}"
                                            BorderBrush="{Binding PreviewBorderBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" CornerRadius="5"
                                                    Background="{Binding PreviewAccentBrush}" />
                                            <Border Width="54" Height="6" CornerRadius="3" Margin="8,0,0,0"
                                                    Background="{Binding PreviewTextBrush}" Opacity="0.85"
                                                    VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Border>

                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                           Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource HintText}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer inf:SmoothScroll.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel Margin="0,0,0,20">

            <!-- 主题（明暗） -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="主题（明暗）" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="「跟随系统」读取 Windows 设置的「应用模式」，系统切换时界面自动跟随；浅色 / 深色是固定选择。配色方案会按当前明暗自动过滤。" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="跟随系统" IsChecked="{Binding IsThemeSystem, Mode=TwoWay}"
                                     Margin="0,0,10,0" />
                        <RadioButton Content="浅色" IsChecked="{Binding IsThemeLight, Mode=TwoWay}"
                                     Margin="0,0,10,0" />
                        <RadioButton Content="深色" IsChecked="{Binding IsThemeDark, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,0"
                               Text="{Binding AppearanceStatusText}" />
                </StackPanel>
            </Border>

            <!-- 配色方案 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="配色方案" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="{Binding ColorSchemeHint}" />
                    <ItemsControl ItemsSource="{Binding ColorSchemes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SchemeCardButton}"
                                        Command="{Binding DataContext.SelectColorSchemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Description}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 背景（PCL2 风格自定义背景 + 玻璃质感） -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="背景" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="只作用于设置/历史/关于/欢迎等窗口；不包含下方的录音悬浮窗（HUD）与 Live2D 桌宠。选择自定义背景后，卡片会变为半透明玻璃质感。" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="背景模式" Style="{StaticResource ValueText}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding BackgroundModeOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedBackgroundMode, Mode=TwoWay}"
                                  MaxWidth="280" HorizontalAlignment="Left" />
                    </Grid>

                    <!-- 图片参数 -->
                    <StackPanel Visibility="{Binding IsBackgroundImageMode, Converter={StaticResource BoolToVis}}"
                                Margin="0,12,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="图片" Style="{StaticResource ValueText}" />
                            <TextBlock Grid.Column="1" Text="{Binding BackgroundImageName}"
                                       Style="{StaticResource MonoText}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="选择图片…"
                                    Command="{Binding PickBackgroundImageCommand}" Margin="8,0,0,0" />
                            <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="移除"
                                    Command="{Binding ClearBackgroundImageCommand}" Margin="6,0,0,0" Padding="10,4" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="图片透明度" Style="{StaticResource ValueText}" />
                            <Slider Grid.Column="1" Minimum="0.2" Maximum="1" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding BackgroundImageOpacity, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding BackgroundImageOpacity, StringFormat={}{0:P0}}"
                                       Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模糊" Style="{StaticResource ValueText}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="60" TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding BackgroundBlurRadius, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding BackgroundBlurRadius, StringFormat={}{0:0}px}"
                                       Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="暗化遮罩" Style="{StaticResource ValueText}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="0.95" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding BackgroundDim, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding BackgroundDim, StringFormat={}{0:P0}}"
                                       Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="填充方式" Style="{StaticResource ValueText}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding BackgroundFitOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedBackgroundFit, Mode=TwoWay}"
                                      MaxWidth="280" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>

                    <!-- 纯色 -->
                    <Grid Visibility="{Binding IsBackgroundSolidMode, Converter={StaticResource BoolToVis}}"
                          Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="背景颜色" Style="{StaticResource ValueText}" />
                        <TextBox Grid.Column="1" Style="{StaticResource InputTextBoxBase}" MaxWidth="280"
                                 HorizontalAlignment="Left" Text="{Binding BackgroundSolidColor, Mode=TwoWay}"
                                 ToolTip="留空则跟随主题卡片色；支持 #RRGGBB 或 #AARRGGBB" />
                    </Grid>

                    <!-- 渐变 -->
                    <StackPanel Visibility="{Binding IsBackgroundGradientMode, Converter={StaticResource BoolToVis}}"
                                Margin="0,12,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="起始色" Style="{StaticResource ValueText}" />
                            <TextBox Grid.Column="1" Style="{StaticResource InputTextBoxBase}" MaxWidth="280"
                                     HorizontalAlignment="Left" Text="{Binding BackgroundGradientStart, Mode=TwoWay}"
                                     ToolTip="留空则跟随主题强调色；支持 #RRGGBB" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="结束色" Style="{StaticResource ValueText}" />
                            <TextBox Grid.Column="1" Style="{StaticResource InputTextBoxBase}" MaxWidth="280"
                                     HorizontalAlignment="Left" Text="{Binding BackgroundGradientEnd, Mode=TwoWay}"
                                     ToolTip="留空则跟随主题背景色；支持 #RRGGBB" />
                        </Grid>
                    </StackPanel>

                    <!-- 玻璃强度 -->
                    <Grid Visibility="{Binding IsBackgroundCustom, Converter={StaticResource BoolToVis}}"
                          Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="玻璃强度" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="0.35" Maximum="1" TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                Value="{Binding BackgroundSurfaceOpacity, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding BackgroundSurfaceOpacity, StringFormat={}{0:P0}}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- 文字对比度：文字颜色跟随主题，浅色背景请切浅色主题 -->
                    <StackPanel Visibility="{Binding IsBackgroundCustom, Converter={StaticResource BoolToVis}}"
                                Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   Text="文字颜色由「主题」的浅色/深色决定：浅色背景请用浅色主题（深色文字 + 浅色卡片），深色背景用深色主题。可以点下面按钮按背景亮度自动匹配。" />
                        <Button Style="{StaticResource SecondaryButton}" Content="按背景亮度匹配主题"
                                Command="{Binding MatchThemeToBackgroundCommand}" HorizontalAlignment="Left"
                                Padding="14,7" Margin="0,8,0,0" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="{Binding BackgroundStatusText}" />
                    <Button Style="{StaticResource GhostButton}" Content="恢复默认背景"
                            Command="{Binding ResetBackgroundCommand}" HorizontalAlignment="Left"
                            Padding="12,6" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 录音悬浮窗（HUD）背景 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="录音悬浮窗（HUD）" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="只作用于录音时屏幕底部的悬浮窗，与上方其他窗口背景互不影响；默认沿用主题的半透明卡片。" />

                    <!-- 实时预览：不保存也会随下方设置变化 -->
                    <TextBlock Text="实时预览" Style="{StaticResource FieldLabel}" Margin="0,6,0,6" />
                    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Height="190" ClipToBounds="True">
                        <Grid IsHitTestVisible="False">
                            <Grid Width="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  LayoutTransform="{Binding HudPreviewTransform}"
                                  Opacity="{Binding HudPreviewCardOpacity}">
                                <Border Margin="18" BorderBrush="{Binding HudPreviewBorderBrush}"
                                        BorderThickness="{Binding HudPreviewBorderThickness}"
                                        CornerRadius="{Binding HudPreviewCornerRadius}"
                                        Effect="{StaticResource HudShadow}">
                                    <Grid>
                                        <Border Background="{Binding HudPreviewBackgroundBrush}"
                                                CornerRadius="{Binding HudPreviewInnerCornerRadius}" />
                                        <Border Background="{Binding HudPreviewDimBrush}"
                                                CornerRadius="{Binding HudPreviewInnerCornerRadius}" />
                                        <Grid Margin="14,10,12,12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Height="4" Width="36" CornerRadius="2"
                                                    Background="{DynamicResource HudHandleBrush}"
                                                    HorizontalAlignment="Center" Margin="0,0,0,10" />
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" Width="54" Height="54" Margin="2,0,14,0">
                                                    <Ellipse Width="46" Height="46" Stroke="{DynamicResource HudRingTrackBrush}"
                                                             StrokeThickness="4" />
                                                    <Ellipse Width="46" Height="46" Stroke="{DynamicResource AccentBrush}"
                                                             StrokeThickness="4" StrokeDashArray="6 8"
                                                             RenderTransformOrigin="0.5,0.5">
                                                        <Ellipse.RenderTransform>
                                                            <RotateTransform Angle="-90" />
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                    <TextBlock Style="{StaticResource GlyphIcon}" FontSize="16"
                                                               Text="&#xE720;" Foreground="{DynamicResource AccentBrush}" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="聆听中…" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock Text="按住 Ctrl+Alt 说话，松开即识别"
                                                               Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="完成" Style="{StaticResource PrimaryButton}" FontSize="12"
                                                            Padding="14,7" Margin="0,0,8,0" />
                                                    <Button Content="取消" Style="{StaticResource GhostButton}" FontSize="12"
                                                            Padding="12,7" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,10" TextWrapping="Wrap"
                               Text="预览随下方设置实时变化（按 55% 显示，仅示意外观）。" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="背景模式" Style="{StaticResource ValueText}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding BackgroundModeOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedHudBackgroundMode, Mode=TwoWay}"
                                  MaxWidth="280" HorizontalAlignment="Left" />
                    </Grid>

                    <!-- 图片参数 -->
                    <StackPanel Visibility="{Binding IsHudBackgroundImageMode, Converter={StaticResource BoolToVis}}"
                                Margin="0,12,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="图片" Style="{StaticResource ValueText}" />
                            <TextBlock Grid.Column="1" Text="{Binding HudBackgroundImageName}"
                                       Style="{StaticResource MonoText}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="选择图片…"
                                    Command="{Binding PickHudBackgroundImageCommand}" Margin="8,0,0,0" />
                            <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="移除"
                                    Command="{Binding ClearHudBackgroundImageCommand}" Margin="6,0,0,0" Padding="10,4" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="图片透明度" Style="{StaticResource ValueText}" />
                            <Slider Grid.Column="1" Minimum="0.2" Maximum="1" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding HudBackgroundImageOpacity, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding HudBackgroundImageOpacity, StringFormat={}{0:P0}}"
                                       Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模糊" Style="{StaticResource ValueText}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="60" TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding HudBackgroundBlurRadius, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding HudBackgroundBlurRadius, StringFormat={}{0:0}px}"
                                       Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="暗化遮罩" Style="{StaticResource ValueText}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="0.95" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding HudBackgroundDim, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding HudBackgroundDim, StringFormat={}{0:P0}}"
                                       Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="填充方式" Style="{StaticResource ValueText}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding BackgroundFitOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedHudBackgroundFit, Mode=TwoWay}"
                                      MaxWidth="280" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>

                    <!-- 纯色 -->
                    <Grid Visibility="{Binding IsHudBackgroundSolidMode, Converter={StaticResource BoolToVis}}"
                          Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="背景颜色" Style="{StaticResource ValueText}" />
                        <TextBox Grid.Column="1" Style="{StaticResource InputTextBoxBase}" MaxWidth="280"
                                 HorizontalAlignment="Left" Text="{Binding HudBackgroundSolidColor, Mode=TwoWay}"
                                 ToolTip="留空则跟随主题 HUD 卡片色；支持 #RRGGBB 或 #AARRGGBB" />
                    </Grid>

                    <!-- 渐变 -->
                    <StackPanel Visibility="{Binding IsHudBackgroundGradientMode, Converter={StaticResource BoolToVis}}"
                                Margin="0,12,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="起始色" Style="{StaticResource ValueText}" />
                            <TextBox Grid.Column="1" Style="{StaticResource InputTextBoxBase}" MaxWidth="280"
                                     HorizontalAlignment="Left" Text="{Binding HudBackgroundGradientStart, Mode=TwoWay}"
                                     ToolTip="留空则跟随主题强调色；支持 #RRGGBB" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="结束色" Style="{StaticResource ValueText}" />
                            <TextBox Grid.Column="1" Style="{StaticResource InputTextBoxBase}" MaxWidth="280"
                                     HorizontalAlignment="Left" Text="{Binding HudBackgroundGradientEnd, Mode=TwoWay}"
                                     ToolTip="留空则跟随主题背景色；支持 #RRGGBB" />
                        </Grid>
                    </StackPanel>

                    <!-- 缩放与卡片外观 -->
                    <TextBlock Text="缩放与卡片外观" Style="{StaticResource FieldLabel}" Margin="0,14,0,8" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="窗口缩放" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="0.7" Maximum="1.5" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" Value="{Binding HudScale, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding HudScaleText}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="圆角半径" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="28" TickFrequency="1"
                                IsSnapToTickEnabled="True" Value="{Binding HudCornerRadius, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding HudCornerRadiusText}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="整体不透明度" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="0.35" Maximum="1" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" Value="{Binding HudCardOpacity, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding HudCardOpacityText}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="描边" Style="{StaticResource FieldLabel}" Margin="0,10,0,8" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="描边颜色" Style="{StaticResource ValueText}" />
                        <TextBox Grid.Column="1" Style="{StaticResource InputTextBoxBase}" MaxWidth="280"
                                 HorizontalAlignment="Left" Text="{Binding HudBorderColor, Mode=TwoWay}"
                                 ToolTip="留空则跟随主题的 HUD 边框色；支持 #RRGGBB 或 #AARRGGBB" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="描边粗细" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="4" TickFrequency="0.25"
                                IsSnapToTickEnabled="True" Value="{Binding HudBorderThickness, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding HudBorderThicknessText}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="{Binding HudBorderStatusText}" />

                    <TextBlock Text="默认位置" Style="{StaticResource FieldLabel}" Margin="0,10,0,8" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="距屏幕底部" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="300" TickFrequency="2"
                                IsSnapToTickEnabled="True" Value="{Binding HudBottomMargin, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding HudBottomMarginText}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="水平偏移" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="-400" Maximum="400" TickFrequency="4"
                                IsSnapToTickEnabled="True" Value="{Binding HudHorizontalOffset, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding HudHorizontalOffsetText}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="默认位置只在没有手动拖动过、或点「重置悬浮窗位置」后生效；拖动过之后以拖动位置为准。" />

                    <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="{Binding HudBackgroundStatusText}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="文字颜色仍由「主题」的浅色/深色决定；图片/深色背景建议用深色主题。" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="恢复默认 HUD 外观"
                                Command="{Binding ResetHudBackgroundCommand}"
                                Padding="12,6" />
                        <Button Style="{StaticResource GhostButton}" Content="重置悬浮窗位置"
                                Command="{Binding ResetOverlayPositionCommand}" Margin="8,0,0,0"
                                Padding="12,6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 界面动效 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="界面动效" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="窗口/设置页/提示框的动画强度。只动画透明度与位移，不影响布局；HUD 与录音流程保持轻量。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="动效档位" Style="{StaticResource ValueText}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding MotionOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedMotionMode, Mode=TwoWay}"
                                  MaxWidth="280" HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 预览 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="预览" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="以下控件实时使用当前配色（未保存也会立即生效）；点「保存」后写入配置文件，下次启动保持。" />
                    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Content="主按钮" Padding="16,7" />
                            <Button Style="{StaticResource SecondaryButton}" Content="次按钮" Padding="16,7"
                                    Margin="10,0,0,0" />
                            <Button Style="{StaticResource GhostButton}" Content="文字按钮" Padding="16,7"
                                    Margin="10,0,0,0" />
                            <Border Width="1" Height="22" Background="{DynamicResource BorderBrush}"
                                    Margin="16,0,16,0" />
                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="强调色" Style="{StaticResource MutedText}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
