<UserControl x:Class="VoxIME.App.Views.SettingsPages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 配色卡片：按钮即卡片，DataContext 为 ColorSchemeOption。 -->
        <Style x:Key="SchemeCardButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="204" CornerRadius="12" Padding="12,10"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <StackPanel>
                                <!-- 迷你窗口色卡：背景 / 卡片 / 强调色 / 正文色条 -->
                                <Border Height="62" CornerRadius="8" Padding="10"
                                        Background="{Binding PreviewBackgroundBrush}"
                                        BorderBrush="{Binding PreviewBorderBrush}" BorderThickness="1">
                                    <Border CornerRadius="6" Padding="8,0" VerticalAlignment="Center"
                                            Background="{Binding PreviewSurfaceBrush}"
                                            BorderBrush="{Binding PreviewBorderBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" CornerRadius="5"
                                                    Background="{Binding PreviewAccentBrush}" />
                                            <Border Width="54" Height="6" CornerRadius="3" Margin="8,0,0,0"
                                                    Background="{Binding PreviewTextBrush}" Opacity="0.85"
                                                    VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Border>

                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                           Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource HintText}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel>

            <!-- 主题（明暗） -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="主题（明暗）" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="「跟随系统」读取 Windows 设置的「应用模式」，系统切换时界面自动跟随；浅色 / 深色是固定选择。配色方案会按当前明暗自动过滤。" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="跟随系统" IsChecked="{Binding IsThemeSystem, Mode=TwoWay}"
                                     Margin="0,0,10,0" />
                        <RadioButton Content="浅色" IsChecked="{Binding IsThemeLight, Mode=TwoWay}"
                                     Margin="0,0,10,0" />
                        <RadioButton Content="深色" IsChecked="{Binding IsThemeDark, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,0"
                               Text="{Binding AppearanceStatusText}" />
                </StackPanel>
            </Border>

            <!-- 配色方案 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="配色方案" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="{Binding ColorSchemeHint}" />
                    <ItemsControl ItemsSource="{Binding ColorSchemes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SchemeCardButton}"
                                        Command="{Binding DataContext.SelectColorSchemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Description}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 预览 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="预览" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="以下控件实时使用当前配色（未保存也会立即生效）；点「保存」后写入配置文件，下次启动保持。" />
                    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Content="主按钮" Padding="16,7" />
                            <Button Style="{StaticResource SecondaryButton}" Content="次按钮" Padding="16,7"
                                    Margin="10,0,0,0" />
                            <Button Style="{StaticResource GhostButton}" Content="文字按钮" Padding="16,7"
                                    Margin="10,0,0,0" />
                            <Border Width="1" Height="22" Background="{DynamicResource BorderBrush}"
                                    Margin="16,0,16,0" />
                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="强调色" Style="{StaticResource MutedText}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
