<UserControl x:Class="VoxIME.App.Views.SettingsPages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:VoxIME.App.Infrastructure">

    <ScrollViewer inf:SmoothScroll.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel>

            <!-- 启动 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="启动与托盘" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="开机自启写入 HKCU\Software\Microsoft\Windows\CurrentVersion\Run（当前用户，无需管理员权限）。" />

                    <CheckBox Content="开机自动启动（静默到托盘）" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                    <CheckBox Content="关闭窗口时最小化到托盘" Margin="0,10,0,0"
                              IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                    <CheckBox Content="显示系统托盘图标" Margin="0,10,0,0"
                              IsChecked="{Binding ShowTrayIcon, Mode=TwoWay}" />
                    <CheckBox Content="启动时显示欢迎引导" Margin="0,10,0,0"
                              IsChecked="{Binding ShowWelcomeOnStartup, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- 历史 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="历史记录" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="识别历史保存在本地 JSONL 文件；条数上限在下次启动时生效。" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="保留条数" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="10" Maximum="2000" TickFrequency="10"
                                IsSnapToTickEnabled="True" Value="{Binding HistoryLimit, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding HistoryLimit}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding HistoryPath}" Style="{StaticResource MonoText}"
                               Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="打开历史记录"
                                Padding="14,7" Command="{Binding OpenHistoryCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="打开数据目录"
                                Padding="14,7" Margin="8,0,0,0"
                                Command="{Binding OpenConfigFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 日志 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="日志" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="日志按天滚动写入本地目录；等级调整在重启应用后生效。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="日志等级" Style="{StaticResource ValueText}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding LogLevels}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}"
                                  MaxWidth="280" HorizontalAlignment="Left" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="打开日志目录"
                                Padding="12,6" Command="{Binding OpenLogsFolderCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding LogDirectory}" Style="{StaticResource MonoText}"
                               Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="12"
                                Background="{DynamicResource AccentGradient}">
                            <TextBlock Text="V" FontSize="20" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="VoxIME 声语" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedText}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="关于 / 许可"
                                Padding="14,7" VerticalAlignment="Center"
                                Command="{Binding OpenAboutCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="配置与历史仅保存在本机 %APPDATA%\VoxIME；API Key 明文保存在 config.json，请勿分享配置文件。ASR 服务由各厂商提供，费用与合规责任由使用者承担。" />
                </StackPanel>
            </Border>

            <!-- 配置导入导出 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="配置导入导出" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="把服务、热键、录音、上屏、桌宠、朗读等设置导出为 JSON，便于备份或迁移到另一台电脑。历史记录、日志和模型文件不包含在内。" />
                    <CheckBox Content="导出时包含 API Key（明文，注意保管）"
                              IsChecked="{Binding ExportSecrets, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="导出配置…"
                                Padding="14,7" Command="{Binding ExportConfigCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="导入配置…"
                                Padding="14,7" Margin="8,0,0,0" Command="{Binding ImportConfigCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="导入会替换当前全部设置；导入前自动备份当前配置，导入后建议重启应用。" />
                </StackPanel>
            </Border>

            <!-- 恢复默认 -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="恢复默认设置" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="把启动、录音、上屏、桌宠、朗读等所有设置恢复为默认值；历史记录不受影响。操作前会再次确认。" />
                    <Button Style="{StaticResource SecondaryButton}" Content="恢复默认"
                            Foreground="{DynamicResource DangerBrush}" Padding="14,7"
                            HorizontalAlignment="Left" Command="{Binding ResetCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
