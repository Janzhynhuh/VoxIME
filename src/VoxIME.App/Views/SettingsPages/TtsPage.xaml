<UserControl x:Class="VoxIME.App.Views.SettingsPages.TtsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:VoxIME.App.Infrastructure">

    <ScrollViewer inf:SmoothScroll.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="语音合成（Windows SAPI）" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="识别完成后可用系统语音朗读结果；朗读音量会同步驱动桌宠口型。" />

                    <CheckBox Content="启用朗读" IsChecked="{Binding TtsEnabled, Mode=TwoWay}" />
                    <CheckBox Content="识别完成后自动朗读结果" Margin="0,10,0,0"
                              IsChecked="{Binding AutoSpeakResult, Mode=TwoWay}" />
                    <CheckBox Content="朗读时驱动桌宠口型" Margin="0,10,0,0"
                              IsChecked="{Binding TtsMouthSync, Mode=TwoWay}" />

                    <TextBlock Text="{Binding TtsStatusText}" Style="{StaticResource HintText}"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="音色与参数" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="语音包" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                    <ComboBox ItemsSource="{Binding TtsVoices}" SelectedItem="{Binding SelectedTtsVoice, Mode=TwoWay}"
                              IsEnabled="{Binding IsTtsAvailable}" />

                    <Grid Margin="0,14,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="语速（-10 ~ 10）" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="-10" Maximum="10" TickFrequency="1"
                                IsSnapToTickEnabled="True" Value="{Binding TtsRate, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding TtsRate}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="音量（0 ~ 100）" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5"
                                IsSnapToTickEnabled="True" Value="{Binding TtsVolume, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding TtsVolume, StringFormat={}{0}%}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Button Style="{StaticResource SecondaryButton}" Content="试听朗读"
                            HorizontalAlignment="Left" Padding="16,8"
                            Command="{Binding TestTtsCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
