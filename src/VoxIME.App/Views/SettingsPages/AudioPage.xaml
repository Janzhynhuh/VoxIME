<UserControl x:Class="VoxIME.App.Views.SettingsPages.AudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:VoxIME.App.Infrastructure"
             xmlns:infra="clr-namespace:VoxIME.App.Infrastructure">

    <ScrollViewer inf:SmoothScroll.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel>

            <!-- 麦克风 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="麦克风" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="选择录音输入设备；“系统默认设备”会跟随 Windows 的声音设置。" />
                    <ComboBox ItemsSource="{Binding AudioDevices}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedAudioDevice, Mode=TwoWay}" />
                    <TextBlock Text="{Binding AudioDeviceHint}" Style="{StaticResource HintText}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="测试麦克风（3 秒）"
                                Padding="14,7" Command="{Binding TestMicCommand}" />
                        <ProgressBar Grid.Column="1" Margin="14,0,14,0" Height="8" VerticalAlignment="Center"
                                     Minimum="0" Maximum="1" Value="{Binding MicTestLevel, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding MicTestStatus}"
                                   Style="{StaticResource HintText}" MaxWidth="280"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 识别上下文 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="识别上下文" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="开始录音时读取当前前台应用，随识别请求一起发送给 ASR 服务，帮助专有名词和场景判断。默认关闭。" />
                    <ComboBox ItemsSource="{Binding AppContextOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Mode"
                              SelectedValue="{Binding AppContextMode, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="“仅应用类型”只发送应用分类和进程名；“应用 + 窗口标题”会额外发送窗口标题（可能包含文件名/网页标题）。不读取窗口内容、剪贴板或选中文字，也不会把上下文写入日志或历史。" />
                </StackPanel>
            </Border>

            <!-- 热键 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="全局热键" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="每个功能可以添加多个热键，任意一个触发即可；在输入框中直接按下组合键录制（例如 Ctrl+Alt、F2）；也支持鼠标侧键（MouseX1/MouseX2/MouseMiddle）。" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="按住说话" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Top" Margin="0,6,0,0" />
                        <StackPanel Grid.Column="1">
                            <ItemsControl ItemsSource="{Binding PushToTalkHotkeys}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox infra:HotkeyCapture.IsEnabled="True"
                                                     Text="{Binding Gesture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="移除"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DataContext.RemovePushToTalkHotkeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource SmallButton}" Content="+ 添加一个热键"
                                    HorizontalAlignment="Left" Margin="0,2,0,0"
                                    Command="{Binding AddPushToTalkHotkeyCommand}" />
                            <TextBlock Text="{Binding PushToTalkError}" Style="{StaticResource DangerText}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasPushToTalkError, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Content="启用" Margin="12,0,0,0" VerticalAlignment="Top"
                                  IsChecked="{Binding EnablePushToTalk, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="切换录音" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Top" Margin="0,6,0,0" />
                        <StackPanel Grid.Column="1">
                            <ItemsControl ItemsSource="{Binding ToggleHotkeys}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox infra:HotkeyCapture.IsEnabled="True"
                                                     Text="{Binding Gesture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="移除"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DataContext.RemoveToggleHotkeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource SmallButton}" Content="+ 添加一个热键"
                                    HorizontalAlignment="Left" Margin="0,2,0,0"
                                    Command="{Binding AddToggleHotkeyCommand}" />
                            <TextBlock Text="{Binding ToggleHotkeyError}" Style="{StaticResource DangerText}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasToggleHotkeyError, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Content="启用" Margin="12,0,0,0" VerticalAlignment="Top"
                                  IsChecked="{Binding EnableToggle, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="取消录音" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Top" Margin="0,6,0,0" />
                        <StackPanel Grid.Column="1">
                            <ItemsControl ItemsSource="{Binding CancelHotkeys}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox infra:HotkeyCapture.IsEnabled="True"
                                                     Text="{Binding Gesture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="移除"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DataContext.RemoveCancelHotkeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource SmallButton}" Content="+ 添加一个热键"
                                    HorizontalAlignment="Left" Margin="0,2,0,0"
                                    Command="{Binding AddCancelHotkeyCommand}" />
                            <TextBlock Text="{Binding CancelHotkeyError}" Style="{StaticResource DangerText}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasCancelHotkeyError, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="提示：热键通过低级键盘/鼠标钩子全局生效，保存后立即应用。鼠标侧键命中已配置热键时会拦截该键的默认行为（如浏览器前进/后退）。若与其它软件冲突，请更换组合键。" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 录音模式 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="录音模式" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,10"
                               Text="按住说话：按住热键时录音，松开立即识别。切换模式：按一下开始，再按一下结束；选择该模式会自动启用上方“切换录音”热键，点击保存后生效。" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="按住说话" GroupName="RecordingMode"
                                     IsChecked="{Binding IsPushToTalkMode, Mode=TwoWay}" />
                        <RadioButton Content="按一下开始 / 再按结束" GroupName="RecordingMode" Margin="12,0,0,0"
                                     IsChecked="{Binding IsToggleMode, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 录音参数 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="录音与静音检测" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,12"
                               Text="静音自动停止用于“按住说话”时忘记松开的场景；阈值越高越不容易被环境噪声触发。" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最长录音时长" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="5" Maximum="600" TickFrequency="5"
                                IsSnapToTickEnabled="True" Value="{Binding MaxDurationSeconds, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding MaxDurationSeconds, StringFormat={}{0} 秒}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="静音超时" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="200" Maximum="5000" TickFrequency="100"
                                IsSnapToTickEnabled="True" Value="{Binding SilenceTimeoutMs, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding SilenceTimeoutMs, StringFormat={}{0} ms}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最短语音" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="100" Maximum="3000" TickFrequency="50"
                                IsSnapToTickEnabled="True" Value="{Binding MinSpeechMs, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding MinSpeechMs, StringFormat={}{0} ms}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="语音检测阈值" Style="{StaticResource ValueText}" />
                        <Slider Grid.Column="1" Minimum="0.001" Maximum="0.2" TickFrequency="0.001"
                                IsSnapToTickEnabled="True" Value="{Binding VadThreshold, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding VadThreshold, StringFormat={}{0:0.000}}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <CheckBox Content="检测到持续静音后自动停止录音" IsChecked="{Binding AutoStopOnSilence, Mode=TwoWay}" />
                    <CheckBox Content="播放录音开始 / 结束提示音" Margin="0,10,0,0"
                              IsChecked="{Binding PlayCues, Mode=TwoWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
