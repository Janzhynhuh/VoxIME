<Window x:Class="VoxIME.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoxIME"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=OkButton}">

    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="18"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="Transparent" Padding="20,16,12,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconBadge" Grid.Column="0" Width="30" Height="30" CornerRadius="9"
                            Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="IconGlyph" Style="{StaticResource GlyphIcon}" FontSize="14"
                                   Text="&#xE946;" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Margin="10,0,0,0" FontSize="14"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;"
                            Click="CancelButton_Click" ToolTip="关闭" />
                </Grid>
            </Border>

            <!-- 内容 -->
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="20,14,20,4" FontSize="13"
                       LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="20,16,20,18">
                <Button x:Name="CancelOptionButton" Style="{StaticResource GhostButton}" Content="取消"
                        Padding="18,8" Margin="0,0,8,0" Click="CancelButton_Click" Visibility="Collapsed" />
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="知道了"
                        MinWidth="96" Click="OkButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
