<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        VoxIME 深色调色板。
        主背景 #12121A / 卡片 #1C1C27 / 强调 #7C5CFF / 正文 #E8E8F0 / 次要 #8A8AA0
    -->

    <!-- 基础色 -->
    <Color x:Key="BgColor">#FF12121A</Color>
    <Color x:Key="CardColor">#FF1C1C27</Color>
    <Color x:Key="CardHoverColor">#FF232331</Color>
    <Color x:Key="InputColor">#FF15151F</Color>
    <Color x:Key="PopupColor">#FF1E1E2B</Color>
    <Color x:Key="AccentColor">#FF7C5CFF</Color>
    <Color x:Key="AccentHoverColor">#FF8F73FF</Color>
    <Color x:Key="AccentSoftColor">#FF2A2350</Color>
    <Color x:Key="TextColor">#FFE8E8F0</Color>
    <Color x:Key="SubtleTextColor">#FF8A8AA0</Color>
    <Color x:Key="MutedTextColor">#FF5F5F74</Color>
    <Color x:Key="BorderColor">#FF2A2A3A</Color>
    <Color x:Key="BorderStrongColor">#FF3A3A52</Color>
    <Color x:Key="SuccessColor">#FF4ADE80</Color>
    <Color x:Key="DangerColor">#FFFF6B6B</Color>
    <Color x:Key="WarningColor">#FFFBBF24</Color>

    <!-- 画刷 -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="PopupBrush" Color="{StaticResource PopupColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="{StaticResource SubtleTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TransparentBrush" Color="#00000000" />

    <!-- 强调渐变（按钮 / Logo / 高亮） -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF9A7BFF" />
        <GradientStop Offset="0.55" Color="#FF7C5CFF" />
        <GradientStop Offset="1" Color="#FF5C3FE0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientHorizontal" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF7C5CFF" />
        <GradientStop Offset="1" Color="#FF4ECBFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ListeningGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF7C5CFF" />
        <GradientStop Offset="1" Color="#FF4ECBFF" />
    </LinearGradientBrush>

    <!-- 字体（WPF 支持逗号分隔的回退列表） -->
    <FontFamily x:Key="AppFont">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <!-- 圆角 / 阴影 -->
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="WindowCornerRadius">16</CornerRadius>
    <DropShadowEffect x:Key="WindowShadow" BlurRadius="32" ShadowDepth="8" Opacity="0.55" Color="#FF000000" />
    <DropShadowEffect x:Key="HudShadow" BlurRadius="26" ShadowDepth="6" Opacity="0.5" Color="#FF000000" />
    <DropShadowEffect x:Key="AccentGlow" BlurRadius="22" ShadowDepth="0" Opacity="0.65" Color="#FF7C5CFF" />

</ResourceDictionary>
